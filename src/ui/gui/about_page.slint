import { Page } from "page.slint";
import { Theme, VButton, Card, ButtonRow } from "theme.slint";

export global AboutData {
    in property <string> version;
    in property <bool> has_update;
}

export component NewVersionButton {
    callback newversion_button_clicked;
    ButtonRow {
        VButton {
            text: @tr("New version available! Click here to download");
            primary: true;
            clicked => {
                newversion_button_clicked();
            }
        }
    }
}

export component About inherits Page {
    callback wiki_button_clicked;
    callback discord_button_clicked;
    callback newversion_button_clicked;
    callback source_code_button_clicked;
    title: @tr("About");

    Card {
        title: "VibeN64";
        description: AboutData.version;

        Text {
            text: @tr("VibeN64 is a fork of Gopher64 that welcomes AI-assisted contributions. The emulation itself is the work of Logan McNaughton and the Gopher64 contributors. VibeN64 is not affiliated with or endorsed by them, so please report problems here and not upstream.");
            color: Theme.text;
            font-size: 13px;
            wrap: word-wrap;
        }

        ButtonRow {
            VButton {
                text: @tr("Source Code");
                clicked => {
                    source_code_button_clicked();
                }
            }

            VButton {
                text: @tr("Report a Problem");
                clicked => {
                    discord_button_clicked();
                }
            }

            VButton {
                text: @tr("Gopher64 Wiki");
                clicked => {
                    wiki_button_clicked();
                }
            }
        }

        if AboutData.has_update: NewVersionButton {
            newversion_button_clicked => {
                newversion_button_clicked();
            }
        }
    }
}
