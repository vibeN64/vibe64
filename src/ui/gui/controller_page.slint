import { ComboBox } from "std-widgets.slint";
import { Page } from "page.slint";
import { Theme, VButton, VSwitch, Card, FieldLabel, ButtonRow } from "theme.slint";
import { State } from "localgame_page.slint";

export global ControllerData {
    in-out property <[bool]> controller_enabled;
    in-out property <[bool]> transferpak;
    in-out property <[string]> gb_rom_paths;
    in-out property <[string]> gb_ram_paths;
    in-out property <[int]> selected_profile_binding: [-1, -1, -1, -1];
    in-out property <[string]> input_profiles;
    in-out property <[string]> controller_names;
    in-out property <[string]> controller_paths;
    in-out property <[int]> selected_controller;
    in-out property <[bool]> controller_changed;
}

// Everything for one controller port: on/off, which pad, which mapping, Transfer Pak
component PortCard inherits Card {
    in property <int> index;
    callback transferpak_toggled(int, bool);

    HorizontalLayout {
        spacing: 12px;

        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 30px;
                height: 30px;
                border-radius: 15px;
                background: ControllerData.controller_enabled[root.index] ? Theme.accent-gradient : Theme.control-background;

                Text {
                    text: root.index + 1;
                    color: ControllerData.controller_enabled[root.index] ? white : Theme.text-muted;
                    font-size: 14px;
                    font-weight: 700;
                }
            }
        }

        Text {
            text: @tr("Player {}", root.index + 1);
            color: Theme.text;
            font-size: 15px;
            font-weight: 700;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }

        VSwitch {
            text: @tr("ControllerSettingsGrid" => "Enabled");
            checked: ControllerData.controller_enabled[root.index];
            toggled => {
                ControllerData.controller_enabled[root.index] = self.checked;
            }
        }
    }

    HorizontalLayout {
        spacing: 14px;

        VerticalLayout {
            spacing: 4px;
            horizontal-stretch: 2;

            FieldLabel {
                text: @tr("Controller");
            }

            ComboBox {
                model: ControllerData.controller_names;
                current-index: ControllerData.selected_controller[root.index];
                selected => {
                    ControllerData.selected_controller[root.index] = self.current-index;
                    ControllerData.controller_changed[root.index] = true;
                }
            }
        }

        VerticalLayout {
            spacing: 4px;
            horizontal-stretch: 1;

            FieldLabel {
                text: @tr("ControllerSettingsGrid" => "Profile");
            }

            ComboBox {
                model: ControllerData.input_profiles;
                current-index: ControllerData.selected_profile_binding[root.index];
                selected => {
                    ControllerData.selected_profile_binding[root.index] = self.current-index;
                }
            }
        }

        VerticalLayout {
            spacing: 4px;
            horizontal-stretch: 0;

            FieldLabel {
                text: @tr("ControllerSettingsGrid" => "Transfer Pak");
            }

            VerticalLayout {
                alignment: center;
                vertical-stretch: 1;

                VSwitch {
                    checked: ControllerData.transferpak[root.index];
                    toggled => {
                        ControllerData.transferpak[root.index] = self.checked;
                        root.transferpak_toggled(root.index, self.checked);
                    }
                }
            }
        }
    }
}

export component ControllerConfig inherits Page {
    callback input_profile_button_clicked;
    callback transferpak_toggled(int, bool);
    callback controller_window_created;
    title: @tr("Controller Configuration");

    init => {
        controller_window_created();
    }

    ButtonRow {
        VButton {
            text: @tr("Configure Input Profile");
            primary: true;
            enabled: !State.game_running;
            clicked => {
                input_profile_button_clicked();
            }
        }
    }

    for player[index] in [0, 1, 2, 3]: PortCard {
        index: index;
        transferpak_toggled(port, enabled) => {
            root.transferpak_toggled(port, enabled);
        }
    }

    Rectangle {
        height: 60px; // so the combobox popups aren't cut off
    }
}
