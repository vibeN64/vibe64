import { Page } from "page.slint";
import { AboutData, NewVersionButton } from "about_page.slint";
import { Theme, VButton, Card, ButtonRow } from "theme.slint";

export global State {
    in-out property <bool> game_running;
    in-out property <bool> is_android;
    in-out property <[{ a: string, b: string }]> recent_roms;
}

component RecentRow inherits Rectangle {
    in property <string> name;
    in property <bool> enabled: true;
    callback clicked;

    height: 44px;
    border-radius: 8px;
    background: touch.has-hover && root.enabled ? Theme.control-background : transparent;
    opacity: root.enabled ? 1 : 0.5;

    accessible-role: button;
    accessible-label: root.name;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 10px;
        spacing: 12px;

        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 8px;
                background: Theme.accent-gradient;

                Path {
                    x: 11px;
                    y: 8px;
                    width: 9px;
                    height: 12px;
                    commands: "M 0 0 L 9 6 L 0 12 Z";
                    fill: white;
                }
            }
        }

        Text {
            text: root.name;
            color: Theme.text;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component LocalGame inherits Page {
    callback open_rom_button_clicked;
    callback saves_folder_button_clicked;
    callback newversion_button_clicked;
    callback recent_rom_button_clicked(string);
    title: @tr("Local Game");

    Rectangle {
        height: 128px;
        border-radius: 16px;
        background: Theme.hero-gradient;

        VerticalLayout {
            padding-left: 24px;
            padding-right: 24px;
            spacing: 4px;
            alignment: center;

            Text {
                text: "VibeN64";
                color: white;
                font-size: 30px;
                font-weight: 800;
            }

            Text {
                text: @tr("Nintendo 64 emulator. Pick a ROM and play.");
                color: #ffffffd9;
                font-size: 13px;
            }
        }
    }

    ButtonRow {
        VButton {
            text: @tr("Open ROM");
            primary: true;
            large: true;
            enabled: !State.game_running;
            clicked => {
                open_rom_button_clicked();
            }
        }

        if !State.is_android: VButton {
            text: @tr("Open Saves Folder");
            large: true;
            clicked => {
                saves_folder_button_clicked();
            }
        }
    }

    if AboutData.has_update: NewVersionButton {
        newversion_button_clicked => {
            newversion_button_clicked();
        }
    }

    Card {
        title: @tr("Recent ROMs");

        if State.recent_roms.length == 0: Text {
            text: @tr("Games you open will be listed here.");
            color: Theme.text-muted;
            font-size: 13px;
        }

        for rom in State.recent_roms: RecentRow {
            name: rom.b;
            enabled: !State.game_running;
            clicked => {
                recent_rom_button_clicked(rom.a);
            }
        }
    }
}
