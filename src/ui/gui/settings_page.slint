import { ComboBox } from "std-widgets.slint";
import { Page } from "page.slint";
import { Card, SettingRow, VSwitch } from "theme.slint";

export global SettingsData {
    in-out property <bool> integer_scaling;
    in-out property <bool> ssaa;
    in-out property <bool> fullscreen;
    in-out property <bool> widescreen;
    in-out property <bool> vsync;
    in-out property <[string]> shader_names;
    in-out property <int> shader;
    in-out property <bool> overclock_n64_cpu;
    in-out property <bool> disable_expansion_pak;
    in-out property <int> resolution;
    in-out property <int> theme;
    in-out property <bool> emulate_usb;
    in-out property <bool> rewind;
    in-out property <bool> emulate_vru;
    in-out property <string> rom_dir;
}

export component Settings inherits Page {
    title: @tr("Settings");

    Card {
        title: @tr("Video");

        SettingRow {
            label: @tr("Resolution:");
            hint: @tr("Internal rendering resolution, as a multiple of the original. With SSAA downscaling on, the picture is scaled back down, so a higher setting only smooths edges.");
            divider: false;

            ComboBox {
                model: ["1x", "2x", "4x", "8x"];
                current-index: SettingsData.resolution;
                selected => {
                    SettingsData.resolution = self.current-index;
                }
            }
        }

        SettingRow {
            label: @tr("SSAA downscaling");
            hint: @tr("Render at the higher resolution, then scale down for smoother edges.");

            VSwitch {
                checked: SettingsData.ssaa;
                toggled => {
                    SettingsData.ssaa = self.checked;
                }
            }
        }

        SettingRow {
            label: @tr("Integer Scaling");
            hint: @tr("Only scale the picture by whole numbers.");

            VSwitch {
                checked: SettingsData.integer_scaling;
                toggled => {
                    SettingsData.integer_scaling = self.checked;
                }
            }
        }

        SettingRow {
            label: @tr("Fullscreen");

            VSwitch {
                checked: SettingsData.fullscreen;
                toggled => {
                    SettingsData.fullscreen = self.checked;
                }
            }
        }

        SettingRow {
            label: @tr("Widescreen (stretch)");

            VSwitch {
                checked: SettingsData.widescreen;
                toggled => {
                    SettingsData.widescreen = self.checked;
                }
            }
        }

        SettingRow {
            label: @tr("VSync");

            VSwitch {
                checked: SettingsData.vsync;
                toggled => {
                    SettingsData.vsync = self.checked;
                }
            }
        }

        SettingRow {
            label: @tr("Shader");
            hint: @tr("How the picture is drawn: sharp or smooth pixels, or CRT, scanline and LCD looks. The CRT, scanline and LCD ones are made for the 1x resolution. Can also be changed while a game is running, from its menu.");

            ComboBox {
                model: SettingsData.shader_names;
                current-index: SettingsData.shader;
                selected => {
                    SettingsData.shader = self.current-index;
                }
            }
        }
    }

    Card {
        title: @tr("Emulation");

        SettingRow {
            label: @tr("Overclock N64 CPU (may cause bugs)");
            divider: false;

            VSwitch {
                checked: SettingsData.overclock_n64_cpu;
                toggled => {
                    SettingsData.overclock_n64_cpu = self.checked;
                }
            }
        }

        SettingRow {
            label: @tr("Disable Expansion Pak");
            hint: @tr("Run with 4 MB of memory instead of 8.");

            VSwitch {
                checked: SettingsData.disable_expansion_pak;
                toggled => {
                    SettingsData.disable_expansion_pak = self.checked;
                }
            }
        }

        SettingRow {
            label: @tr("Enable Rewind");

            VSwitch {
                checked: SettingsData.rewind;
                toggled => {
                    SettingsData.rewind = self.checked;
                }
            }
        }

        SettingRow {
            label: @tr("Emulate UNFLoader");
            hint: @tr("USB debug link used by homebrew developers.");

            VSwitch {
                checked: SettingsData.emulate_usb;
                toggled => {
                    SettingsData.emulate_usb = self.checked;
                }
            }
        }

        SettingRow {
            label: @tr("Emulate VRU");
            hint: @tr("The Voice Recognition Unit microphone accessory.");

            VSwitch {
                checked: SettingsData.emulate_vru;
                toggled => {
                    SettingsData.emulate_vru = self.checked;
                }
            }
        }
    }

    Card {
        title: @tr("UI");

        SettingRow {
            label: @tr("Theme:");
            divider: false;

            ComboBox {
                model: [@tr("System"), @tr("Dark"), @tr("Light")];
                current-index: SettingsData.theme;
                selected => {
                    SettingsData.theme = self.current-index;
                }
            }
        }
    }

    Rectangle {
        height: 60px; // so the combobox popup isn't cut off
    }
}
