import { Page } from "page.slint";
import { Theme, VButton, Card, ButtonRow } from "theme.slint";
import { State } from "localgame_page.slint";

export global NetplayData {
    in-out property <string> player_name;
    in-out property <string> game_name;
    in-out property <string> game_hash;
    in-out property <string> game_cheats;
    in-out property <string> rom_path;
    in-out property <string> password;
    in-out property <bool> pending_session;
    in-out property <bool> pending_refresh;
    in-out property <string> session_name;
    in-out property <[[StandardListViewItem]]> sessions;
    in-out property <int> current_session: -1;

    in-out property <bool> show_wait_session;
    in-out property <bool> show_create_session;
    in-out property <bool> show_join_session;
    // false unless the user has set up a netplay server of their own
    in property <bool> available;
}

export component Netplay inherits Page {
    callback create_session_button_clicked;
    callback join_session_button_clicked;
    title: @tr("Netplay");

    if !NetplayData.available: Card {
        title: @tr("Netplay is switched off");

        Text {
            text: @tr("VibeN64 does not run a netplay server, and it does not use the Gopher64 project's server. To play online you need a server of your own: run the open source gopher64-netplay-server, then start VibeN64 with NETPLAY_SERVER_URL set to its address.");
            color: Theme.text-muted;
            font-size: 13px;
            wrap: word-wrap;
        }
    }

    if NetplayData.available: Card {
        title: @tr("Play online");
        description: @tr("Host a session for friends to join, or join one that is already running. Sessions go through the netplay server you configured.");

        ButtonRow {
            VButton {
                enabled: !State.game_running;
                primary: true;
                large: true;
                text: @tr("Create Session");
                clicked => {
                    create_session_button_clicked();
                }
            }

            VButton {
                enabled: !State.game_running;
                large: true;
                text: @tr("Join Session");
                clicked => {
                    join_session_button_clicked();
                }
            }
        }
    }
}
